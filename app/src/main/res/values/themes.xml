<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AttenTrack" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="bottomNavigationStyle">@style/Widget.Attendance.BottomNav</item>
    </style>

    <style name="Theme.Attendance" parent="Theme.AttenTrack" />

    <!-- Blue header er upor icon / back button shada -->
    <style name="ThemeOverlay.Attendance.Toolbar" parent="">
        <item name="colorControlNormal">@color/header_text</item>
    </style>

    <!-- Header er niche rounded white sheet (reference design) -->
    <style name="ShapeAppearanceOverlay.Attendance.SheetTop" parent="">
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.Attendance.Sheet" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/app_background</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Attendance.SheetTop</item>
    </style>

    <style name="Widget.Attendance.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/app_surface</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Attendance.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/app_surface</item>
        <item name="itemIconTint">@color/nav_item_tint</item>
        <item name="itemTextColor">@color/nav_item_tint</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Attendance.BottomNav.Indicator</item>
    </style>

    <style name="Widget.Attendance.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/brand_primary_container</item>
    </style>

    <style name="TextAppearance.Attendance.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Attendance.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Attendance.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Attendance.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.Attendance.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".StudentDashboardFragment">

    <include
        android:id="@+id/header"
        layout="@layout/view_home_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Attendance.Sheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-24dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Attendance.Card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="20dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/overall_attendance"
                                    android:textAppearance="@style/TextAppearance.Attendance.Caption"
                                    android:textSize="14sp" />

                                <FrameLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp">

                                    <com.google.android.material.progressindicator.CircularProgressIndicator
                                        android:id="@+id/progressOverall"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:indeterminate="false"
                                        android:max="100"
                                        app:indicatorSize="150dp"
                                        app:trackCornerRadius="8dp"
                                        app:trackThickness="14dp"
                                        tools:ignore="TooDeepLayout" />

                                    <TextView
                                        android:id="@+id/tvOverallPct"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:textSize="30sp"
                                        android:textStyle="bold" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="18dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tvStatTotal"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:gravity="center"
                                        android:textColor="@color/text_primary"
                                        android:textSize="13sp" />

                                    <TextView
                                        android:id="@+id/tvStatAttended"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:gravity="center"
                                        android:textColor="@color/success"
                                        android:textSize="13sp" />

                                    <TextView
                                        android:id="@+id/tvStatLate"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:gravity="center"
                                        android:textColor="@color/warning"
                                        android:textSize="13sp" />

                                    <TextView
                                        android:id="@+id/tvStatAbsent"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:gravity="center"
                                        android:textColor="@color/danger"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvWarning"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:background="@drawable/bg_stat_box"
                                    android:backgroundTint="@color/danger_container"
                                    android:padding="12dp"
                                    android:textColor="@color/danger"
                                    android:textSize="13sp"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="8dp"
                            android:text="@string/needs_attention"
                            android:textAppearance="@style/TextAppearance.Attendance.Section" />

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Attendance.Card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:id="@+id/llAttention"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical" />

                                <TextView
                                    android:id="@+id/tvAttentionEmpty"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="16dp"
                                    android:textAppearance="@style/TextAppearance.Attendance.Caption"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="8dp"
                            android:text="@string/recent_classes"
                            android:textAppearance="@style/TextAppearance.Attendance.Section" />

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Attendance.Card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:id="@+id/llRecent"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical" />

                                <TextView
                                    android:id="@+id/tvRecentEmpty"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="16dp"
                                    android:text="@string/no_classes_have_been_recorded"
                                    android:textAppearance="@style/TextAppearance.Attendance.Caption"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <include
                android:id="@+id/state"
                layout="@layout/view_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>